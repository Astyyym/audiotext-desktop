# 忽略规则（项目初始化）

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.eggs/
build/
dist/
*.spec
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node / 前端 ----
node_modules/
out/
.output/
.vite/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---- 模型与二进制（体积大，不进仓库；用发布包/对象存储分发） ----
models/
cuda/
*.bin
*.gguf
*.onnx
*.pt
bin/ffmpeg.exe
bin/ffprobe.exe

# ---- 构建产物 ----
release/
installer/output/
*.exe
*.msi
*.dmg
*.AppImage

# ---- 运行产物 / 示例输出 ----
output/
samples_out/
*.tmp
.tmp_test/

# ---- 系统 ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- 本地配置 / 密钥 ----
.env
*.local
config.local.*
!app/config.local.example.json

# 本地执行记录不公开；旧原型预览含私人演示资料，仅本地保留。
docs/internal/
designs/**/preview.png

test.txt
